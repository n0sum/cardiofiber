# ======================================================================
#  Tutto cio' che run_all.sh rigenera, piu' cio' che non si puo'
#  redistribuire. Dei dati entrano solo gli ingressi che non si
#  rigenerano, con eccezioni esplicite in fondo.
# ======================================================================

# dati e risultati; data/clinical/ non entra mai
/data/*
/output/
/papers/

# build
build/
cmake-build-*/
*.o
*.a
*.so
*.obj

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# IDE / editor
.idea/
.vscode/
*.swp
*~

# Claude Code: la configurazione locale non e' ricetta
.claude/settings.local.json

# ----------------------------------------------------------------------
# Rete di sicurezza: formati di dato pesante, dovunque si trovino.
# Impedisce che un dato finito fuori da data/ per sbaglio entri in git.
# ----------------------------------------------------------------------
*.h5
*.igb
*.vtk
*.vtu
*.vtp
*.ply
*.stl
*.mesh
*.npz
*.pts
*.elem
*.lon
*.vtx
*.log

# ----------------------------------------------------------------------
# Ingressi in git, gli unici dati che non si rigenerano: l'SSM e
# l'uscita di AugmentA letta da run_all.sh. In fondo, per prevalere
# sulla rete di sicurezza.
# ----------------------------------------------------------------------
!/data/external/
/data/external/*
!/data/external/biatrial_model_completeFit.h5
!/data/augmenta/
/data/augmenta/*
!/data/augmenta/LA_endo_with_fiber.pts
!/data/augmenta/LA_endo_with_fiber.elem
!/data/augmenta/LA_endo_with_fiber.lon
